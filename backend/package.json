{
  "name": "sarathi-backend",
  "version": "1.0.0",
  "description": "SARATHI — Public Transport Management System Backend",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "npm run clean && tsc -p tsconfig.json",
    "preview": "npm run build && npm run start",
    "start": "node build/index.js",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
