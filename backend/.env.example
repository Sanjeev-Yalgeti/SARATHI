# ─────────────────────────────────────────────
#  SARATHI Backend — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Default 5001 (macOS AirPlay squats on 5000). Keep in sync with FRONTEND_HANDOFF.md.
PORT=5001
NODE_ENV=development

# ── Database (Prisma + SQLite file DB, step 0) ──
DATABASE_URL="file:./prisma/dev.db"

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Google Maps Platform ──────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Intelligence fallbacks ──────────────────────────────────────────────
# Leave these unset to use the public Open-Meteo and OSRM endpoints.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
IMD_BASE_URL=
# ── Disaster-ML sidecar ───────────────────────────────────────────────
# local prediction engine: `uvicorn serve:app --port 8000` from backend/disaster-ml/src/
ML_URL=http://localhost:8000

# ── HERE Maps — RETIRED/abandoned (card required even for free tier) ──
# Endpoints return 410. Do not request a key.
# HERE_API_KEY=

# ── OSRM (self-hosted or public demo) ─────────
OSRM_BASE_URL=https://router.project-osrm.org

# ── Auth (Step 2) ─────────────────────────────────
# JWT_SECRET must be a long random string (min 32 chars), server-only, never committed.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h

# ── GTFS / Government Transport APIs ──────────
GTFS_API_KEY=your_gtfs_api_key_here
GTFS_API_BASE_URL=https://api.example.com/gtfs
