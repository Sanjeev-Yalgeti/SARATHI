# ─────────────────────────────────────────────
#  SARATHI Backend — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ── Database (Prisma + SQLite file DB, step 0) ──
DATABASE_URL="file:./prisma/dev.db"

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Google Maps Platform ──────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Intelligence fallbacks ──────────────────────────────────────────────
# Leave these unset to use the public Open-Meteo and OSRM endpoints.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
IMD_BASE_URL=
ML_URL=http://localhost:8000

# ── HERE Maps ─────────────────────────────────
HERE_API_KEY=your_here_api_key_here

# ── OSRM (self-hosted or public demo) ─────────
OSRM_BASE_URL=https://router.project-osrm.org

# ── GTFS / Government Transport APIs ──────────
GTFS_API_KEY=your_gtfs_api_key_here
GTFS_API_BASE_URL=https://api.example.com/gtfs
